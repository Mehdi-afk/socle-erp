{
  "name": "@socle/framework",
  "version": "0.1.0",
  "private": true,
  "description": "Isomorphic core: registry, ORM, security, views, i18n",
  "license": "LGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "socle-api": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "api:check": "tsc -p tsconfig.api.json && api-extractor run",
    "api:update": "tsc -p tsconfig.api.json && api-extractor run --local"
  },
  "dependencies": {
    "@socle/crypto": "workspace:*",
    "semver": "^7.8.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "fast-check": "^4.10.2"
  }
}
