{
  "name": "@socle/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system: tokens, components, RTL, dark mode",
  "license": "LGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "guide": "vite --config vite.guide.config.ts",
    "capture": "node --import ../../apps/cli/bin/ts-hooks.mjs scripts/capture-guide.ts",
    "guide:build": "vite build --config vite.guide.config.ts",
    "build:tokens": "node --import ../../apps/cli/bin/ts-hooks.mjs scripts/build-tokens.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "fast-check": "^4.10.2",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "stylelint": "17.16.0",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-direction": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
