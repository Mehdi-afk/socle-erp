{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Never propose a version published less than 7 days ago",
      "matchPackageNames": ["*"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "One weekly PR for all non-major npm updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "One weekly PR for GitHub Actions (digests stay pinned)",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "typescript-eslint does not support TypeScript >= 6.1 yet",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1",
      "minimumReleaseAge": "7 days"
    }
  ]
}
