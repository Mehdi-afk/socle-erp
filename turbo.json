{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "api:check": {
      "dependsOn": ["^api:check"],
      "outputs": []
    },
    "api:update": {
      "dependsOn": ["^api:update"],
      "outputs": [],
      "cache": false
    }
  }
}
